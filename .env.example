# FreeF1 Race Control on Render
# Copy to .env for local development. Never commit real credentials.

# Set a unique username, strong password, and at least 32 random secret chars.
# In production the server refuses to boot if these are unset/weak.
ADMIN_USER=change-me
ADMIN_PASS=replace-with-a-long-random-password
ADMIN_PASS_MIN_LENGTH=16
ADMIN_SECRET=replace-with-64-random-hex-characters

# Public static site and CORS origin.
SITE_URL=https://freef1.netlify.app
ALLOWED_ORIGIN=https://freef1.netlify.app
# For local browser testing, include both local static-site origins too:
# ALLOWED_ORIGIN=https://freef1.netlify.app,http://localhost:4173,http://127.0.0.1:4173
# Keep public news output hidden while preserving News admin data/CRUD.
PUBLIC_NEWS_ENABLED=false
TRUST_PROXY_HOPS=1
# Optional: restrict /admin to exact IPv4 addresses or CIDRs.
# ADMIN_IP_ALLOWLIST=102.132.7.9,41.13.0.0/16

# Recommended for settings that must survive Render restarts. Without Redis,
# state is kept in DATA_DIR and survives only if that directory is on a disk.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
# DATA_DIR=/var/data/freef1

# Discord bot is independent and optional; leaving token unset keeps it off.
DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_OWNER_ID=
# DISCORD_INVITE=https://discord.gg/your-invite

# Optional Help tickets; keep false until the bot has Manage Channels, the
# Message Content Intent is enabled in the Developer Portal, and durable
# Upstash storage or a persistent Render disk is configured.
DISCORD_TICKETS_ENABLED=false
# DISCORD_TICKET_CATEGORY_ID=  # optional parent category for private ticket channels
# DISCORD_TICKET_STAFF_ROLE_ID=  # optional role allowed to view/reply; owner always retains access

PORT=3000
NODE_ENV=production

# Generate secrets with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Discord membership gate (4K feed) ─────────────────────────────────
# Create an app at https://discord.com/developers/applications, then OAuth2 →
# add the redirect URI exactly as below and copy the client id/secret here.
# ── 4K Superlicense gate (/link) ────────────────────────────────────────────
# No OAuth app credentials are used any more: the browser shows a five-digit code, the member
# runs /link <code> in #4k-access, and the bot vouches for them. The bot token from above is
# reused, plus one shared secret so only the bot can approve a code.
DISCORD_GUILD_ID=
# The bot vouches for /link codes with this secret. Leave it blank and the backend mints one
# in-process at boot, which is fine while the bot runs inside the same service. Set it only if
# the bot ever runs as a separate worker, or if you want it pinned.
DISCORD_BOT_SECRET=
DISCORD_GUILD_INVITE=https://discord.gg/your-invite
# The channel /link must be run in. ID is exact; the name is the fallback.
# DISCORD_LINK_CHANNEL_ID=
DISCORD_LINK_CHANNEL_NAME=4k-access
# Delete anything people type in that channel (needs Manage Messages). /link replies are
# ephemeral, so this never removes a member's own confirmation. false switches the sweep off.
DISCORD_LINK_SWEEP=true
# Optional: require a role on top of membership.
# DISCORD_REQUIRED_ROLE=
# Optional: how often a linked account is re-checked for having left (seconds, default 300).
# DISCORD_MEMBER_CACHE_SECONDS=300
# DISCORD_SESSION_SECRET=
# DISCORD_4K_URL=https://embdlol.st/embed/01a18e52-f25b-7368-a19d-9f590427cf4e
DISCORD_GATE_ENABLED=true
