# FreeF1 Race Control on Render
# Copy to .env for local development. Never commit real credentials.

# Set a unique username, strong password, and at least 32 random secret chars.
# In production the server refuses to boot if these are unset/weak.
ADMIN_USER=change-me
ADMIN_PASS=replace-with-a-long-random-password
ADMIN_PASS_MIN_LENGTH=16
ADMIN_SECRET=replace-with-64-random-hex-characters

# Public static site and CORS origin.
SITE_URL=https://freef1.netlify.app
ALLOWED_ORIGIN=https://freef1.netlify.app
# For local browser testing, include both local static-site origins too:
# ALLOWED_ORIGIN=https://freef1.netlify.app,http://localhost:4173,http://127.0.0.1:4173
TRUST_PROXY_HOPS=1
# Optional: restrict /admin to exact IPv4 addresses or CIDRs.
# ADMIN_IP_ALLOWLIST=102.132.7.9,41.13.0.0/16

# Recommended for settings that must survive Render restarts. Without Redis,
# state is kept in DATA_DIR and survives only if that directory is on a disk.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
# DATA_DIR=/var/data/freef1

# Discord bot is independent and optional; leaving token unset keeps it off.
DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_OWNER_ID=
# DISCORD_INVITE=https://discord.gg/your-invite

# Optional Help tickets; keep false until the bot has Manage Channels, the
# Message Content Intent is enabled in the Developer Portal, and durable
# Upstash storage or a persistent Render disk is configured.
DISCORD_TICKETS_ENABLED=false
# DISCORD_TICKET_CATEGORY_ID=  # optional parent category for private ticket channels
# DISCORD_TICKET_STAFF_ROLE_ID=  # optional extra comma-separated role IDs allowed to view/reply (role 1566540793794134226 and owner always retain access)

PORT=3000
NODE_ENV=production

# Generate secrets with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── 4K feed (no gate) ───────────────────────────────────────────────────────
# The 4K chip is public: clicking it shows a "join the Discord for session
# alerts" nudge and then plays. The address is resolved server-side from
# embdlol's directory and served by GET /api/stream/uhd.
# Pin the address here to skip the lookup entirely (useful when the upstream
# catalogue drops the channel).
# DISCORD_4K_URL=https://embdlol.st/embed/<channel-id>
